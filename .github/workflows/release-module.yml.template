name: Release __MODULE__

# Generated from release-module.yml.template by scripts/add-module.sh.

on:
  workflow_dispatch:
    inputs:
      force_build:
        description: "Force build — replace the release for the module's current commit."
        type: boolean
        default: false

# Forked repos default to a read-only GITHUB_TOKEN.
permissions:
  contents: write

jobs:
  release:
    uses: ./.github/workflows/_release-module.yml
    with:
      module_path: __MODULE_PATH__
      force_build: ${{ inputs.force_build }}
    secrets: inherit
